# ═══════════════════════════════════════════════════════════
#  AlertMind ITSM — Cloud Agent / local development .env template
#  scripts/dev/install.sh and scripts/dev/start.sh copy this to `.env`
#  (the real .env is gitignored). Values target the containerized
#  `docker compose` stack and use in-Docker service DNS names.
#  These are NON-SECRET local dev defaults — do not use in production.
# ═══════════════════════════════════════════════════════════

# DEBUG=True (NODE_ENV != production) for dev ergonomics. Keycloak and OPA still
# run locally, so auth/authz are enforced; DEBUG only relaxes the OPA-unreachable
# path and enables Django error pages.
NODE_ENV=development

# ── Database (Postgres + pgvector) ────────────────────────
DATABASE_URL=postgresql://alertmind:alertmind_secret@db:5432/alertmind
POSTGRES_DB=alertmind
POSTGRES_USER=alertmind
POSTGRES_PASSWORD=alertmind_secret

# ── Redis (Celery broker + result backend) ────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth (Keycloak OIDC) ──────────────────────────────────
KEYCLOAK_SERVER_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=alertmind
KEYCLOAK_AUDIENCE=alertmind-frontend
JWT_SECRET=local-dev-django-secret-key-change-me-please-32chars

# ── Authorization (OPA) ───────────────────────────────────
OPA_URL=http://opa:8181/v1/data/alertmind/authz

# ── Inbound webhook shared secret (Alertmanager / n8n) ────
# Send `Authorization: Bearer ${WEBHOOK_SECRET}` to /api/webhook/*.
WEBHOOK_SECRET=dev-webhook-secret

# ── CORS: SPA origins allowed to call the API ─────────────
FRONTEND_URL=http://localhost:8090,http://localhost:5175,http://localhost:5173

# ── LLM / embeddings (optional, external) ─────────────────
# The Ollama host is external to this dev VM and unreachable here, so RAG/LLM
# analysis degrades gracefully (tickets still created; ai_confidence=0). Set
# LLM_API_KEY (+ LLM_API_BASE/LLM_API_MODEL) to enable real generation.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.3:70b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
SLA_SCAN_INTERVAL_SECONDS=60

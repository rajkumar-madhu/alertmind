# ═══════════════════════════════════════════════════════════
#  AlertMind ITSM — Environment Configuration
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# production = DEBUG off (signed JWT + OPA fail-closed)
NODE_ENV=production
PORT=4000

# ── Frontend (wecrew production) ──────────────────────────
# SPA:  https://alertmind.wecrew.in
# API:  https://alertmind.api.wecrew.in
# Local compose instead: VITE_API_URL=  (empty; Vite proxies /api → :4000)
#                        FRONTEND_URL=http://localhost:5173,http://localhost:5175,http://localhost:8090
VITE_API_URL=https://alertmind.api.wecrew.in
FRONTEND_URL=https://alertmind.wecrew.in
VITE_OPS_URL=https://ops.wecrew.in

# Django Host header (comma-separated). Prod ConfigMap sets this too.
ALLOWED_HOSTS=alertmind.wecrew.in,alertmind.api.wecrew.in,api,.wecrew.in,localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────
# SUPABASE_* keys are unused by Django; kept for older compose files.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

DATABASE_URL=postgresql://alertmind:alertmind_secret@db:5432/alertmind
POSTGRES_DB=alertmind
POSTGRES_USER=alertmind
POSTGRES_PASSWORD=alertmind_secret

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES=7d

# Inbound Alertmanager / n8n webhooks (Authorization: Bearer <secret>).
# Unset: in-cluster wecrew-ops → ClusterIP still works; public *.wecrew.in is denied.
WEBHOOK_SECRET=change-me-webhook-secret
WEBHOOK_PUBLIC_HOSTS=.wecrew.in

# ── Ollama / LLM ─────────────────────────────────────────
# Local compose: host Ollama. Prod overlay: http://ollama-embed:11434
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.3:70b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
LLM_TEMP=0.2
LLM_CTX=8192
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Notifications ─────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Service Credentials ───────────────────────────────────
FLOWISE_USER=admin
FLOWISE_PASS=flowise_secret
N8N_USER=admin
N8N_PASS=n8n_secret

# ── Domain ────────────────────────────────────────────────
# Production public host. Local compose: DOMAIN=localhost
DOMAIN=alertmind.wecrew.in
LOG_LEVEL=info

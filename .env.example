# ═══════════════════════════════════════════════════════════
#  AlertMind ITSM — Environment Configuration
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000

# ── Frontend ─────────────────────────────────────────────
VITE_API_URL=http://173.249.2.23:4000
FRONTEND_URL=http://173.249.2.23,http://173.249.2.23:5173

# ── Database (Supabase / Postgres) ────────────────────────
SUPABASE_URL=http://173.249.2.23:8000
SUPABASE_SERVICE_KEY=your-supabase-service-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# If using direct Postgres instead of Supabase:
DATABASE_URL=postgresql://alertmind:alertmind_secret@db:5432/alertmind
POSTGRES_DB=alertmind
POSTGRES_USER=alertmind
POSTGRES_PASSWORD=alertmind_secret

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES=7d

# Inbound Alertmanager / n8n webhooks (Authorization: Bearer <secret>).
# Required when NODE_ENV=production — the API fails closed if this is empty.
WEBHOOK_SECRET=change-me-webhook-secret

# ── Ollama / LLM ─────────────────────────────────────────
OLLAMA_BASE_URL=http://173.249.2.23:11434
LLM_MODEL=llama3.3:70b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
LLM_TEMP=0.2
LLM_CTX=8192
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Notifications ─────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Service Credentials ───────────────────────────────────
FLOWISE_USER=admin
FLOWISE_PASS=flowise_secret
N8N_USER=admin
N8N_PASS=n8n_secret

# ── Domain ────────────────────────────────────────────────
DOMAIN=173.249.2.23
LOG_LEVEL=info
